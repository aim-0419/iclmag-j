# ====================================
# 환경변수 예시 파일
# ------------------------------------
# 이 파일을 복사해서 .env.local 을 만든 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env.local
#
# .env.local 에는 비밀번호가 들어가므로 git 에 올라가지 않습니다.
# 절대 외부에 공유하지 마세요.
# ====================================

# ------------------------------------
# 데이터베이스 (MySQL)
# 형식: mysql://아이디:비밀번호@주소:포트/DB이름
# ------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/iclmag"

# ------------------------------------
# 로그인 인증 (JWT)
# ------------------------------------
# 로그인 증명서에 서명할 비밀 열쇠입니다.
# 반드시 32자 이상의 무작위 문자열로 바꿔 주세요. (아래 명령으로 생성 가능)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# 로그인 유지 기간 (예: 7d=7일, 24h=24시간, 60m=60분)
JWT_EXPIRES_IN="7d"

# ------------------------------------
# 사이트 주소
# ------------------------------------
# 비밀번호 재설정 메일의 링크 주소를 만들 때 사용합니다.
# 실제 서비스에서는 반드시 https 주소로 바꿔 주세요.
# (https 로 설정해야 로그인 쿠키에 보안 옵션이 켜집니다.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------
# 메일 발송 (회원가입 인증코드 / 비밀번호 재설정)
# ------------------------------------
# Gmail 을 사용할 경우 계정 비밀번호가 아니라 "앱 비밀번호"를 발급받아 넣어야 합니다.
# 발급 방법: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_USER="보내는계정@gmail.com"
EMAIL_PASS="앱-비밀번호-16자리"
EMAIL_FROM="이끌림필라테스매거진 <보내는계정@gmail.com>"
