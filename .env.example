# ====================================
# 데이터베이스 설정 (MySQL)
# ====================================
# 형식: mysql://유저명:비밀번호@호스트:포트/DB명
DATABASE_URL="mysql://root:password@localhost:3306/iclmag"

# ====================================
# JWT 인증 설정
# ====================================
# 최소 32자 이상의 랜덤 문자열 사용 권장
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# 토큰 만료 시간 (예: 7d, 24h, 60m)
JWT_EXPIRES_IN="7d"

# ====================================
# 앱 설정
# ====================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ICLMAG"
